# PostgreSQL connection string for SetareganPlus.
# Replace placeholders before running migrations on the VPS.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/setareganplus?schema=public"

# Persistent media root (outside the git deploy tree). Production example:
# STAROS_MEDIA_ROOT=/var/www/staros-media
STAROS_MEDIA_ROOT=

# Public URL prefix served by Nginx alias (no trailing slash required).
# Example: /media → files at /media/forms/<file>
# IMPORTANT: Do NOT expose `/media/private/` (registration document uploads).
# Deny or omit that prefix from the Nginx alias so private/form-uploads stay private.
STAROS_MEDIA_PUBLIC_BASE=/media

# Payment provider (Sprint 4A). Default mock — real PSPs added later.
STAROS_PAYMENT_PROVIDER=mock

# Optional AI assistance (advisory only — booking works without AI).
# Never commit real API keys.
STAROS_AI_ENABLED=false
STAROS_AI_PROVIDER=none
# STAROS_AI_ENDPOINT=
# STAROS_AI_API_KEY=
# STAROS_AI_TIMEOUT_MS=4000

# Public StarOS AI Assistant (frontend chat widget) — brand: ستاره
# Defaults to https://ai.setareganplus.ir when unset.
NEXT_PUBLIC_AI_STAROS_URL=https://ai.setareganplus.ir
# NEXT_PUBLIC_AI_STAROS_CHAT_PATH=/api/chat
# NEXT_PUBLIC_AI_STAROS_TIMEOUT_MS=20000
# Feature flags (defaults shown)
# NEXT_PUBLIC_AI_MEMORY_ENABLED=true
# NEXT_PUBLIC_AI_DEEP_CONTEXT_ENABLED=true
# NEXT_PUBLIC_AI_SMART_SUGGESTIONS_ENABLED=true
# NEXT_PUBLIC_AI_SITE_SEARCH_ENABLED=true
# NEXT_PUBLIC_AI_CITATIONS_ENABLED=true
# NEXT_PUBLIC_AI_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_AI_STREAMING_ENABLED=false
# NEXT_PUBLIC_AI_VOICE_INPUT_ENABLED=false
# NEXT_PUBLIC_AI_VOICE_OUTPUT_ENABLED=false
# NEXT_PUBLIC_AI_PLUGINS_ENABLED=false
# NEXT_PUBLIC_AI_PLANNING_ENABLED=true
# AI CRM admissions layer (payload only; no DB writes). Off by default.
# AI_CRM_ENABLED=false
# NEXT_PUBLIC_AI_CRM_ENABLED=false
# NEXT_PUBLIC_AI_MAX_HISTORY=20
# NEXT_PUBLIC_AI_SITE_SEARCH_THRESHOLD=4

# Published form / booking slugs for site page embeds (transitional fallback only).
# Prefer admin panel → جایگاه‌های سایت. Database placements override these values.
# Set on the VPS only if panel placements are not configured yet.
PRE_REGISTRATION_FORM_SLUG=
CONSULTATION_FORM_SLUG=
CONSULTATION_BOOKING_SERVICE_SLUG=
# Optional public mirrors (same values) if client needs them later:
# NEXT_PUBLIC_PRE_REGISTRATION_FORM_SLUG=
# NEXT_PUBLIC_CONSULTATION_FORM_SLUG=
# NEXT_PUBLIC_CONSULTATION_BOOKING_SERVICE_SLUG=

# ─── SMS / OTP communication (StarOS v0.8.1) ──────────────────────────────────
# Safe defaults: disabled Null provider. Never commit real API keys or mobiles.
STAROS_SMS_ENABLED=false
STAROS_SMS_PROVIDER=null
STAROS_SMS_MAX_ATTEMPTS=5
STAROS_SMS_WORKER_BATCH=20

# SMS.ir verify-template adapter. Set STAROS_SMS_PROVIDER=smsir and enable only
# after all production values have been configured on the deployment host.
SMSIR_API_KEY=
SMSIR_API_BASE_URL=https://api.sms.ir
SMSIR_TIMEOUT_MS=8000
SMSIR_OTP_TEMPLATE_ID=
SMSIR_BOOKING_TEMPLATE_ID=
SMSIR_FORM_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=CODE
SMSIR_BOOKING_PARAM_NAME=NAME
SMSIR_BOOKING_PARAM_DATE=DATE
SMSIR_BOOKING_PARAM_TIME=TIME
SMSIR_BOOKING_PARAM_TRACKING=TRACKING
SMSIR_FORM_PARAM_NAME=NAME
SMSIR_FORM_PARAM_TRACKING=TRACKING

# Explicit guard for the manual real-provider test; leave empty in production.
SMSIR_TEST_CONFIRM=
SMSIR_TEST_MOBILE=

# OTP defaults: 6 digits, hashed only, 2-minute expiry
STAROS_OTP_EXPIRY_SECONDS=120
STAROS_OTP_RESEND_COOLDOWN_SECONDS=60
STAROS_OTP_MAX_ATTEMPTS=5

# ─── CRM automation (StarOS v0.7) ─────────────────────────────────────────────
# STAROS_CRM_WORKER_BATCH=20
# Cron suggestion (VPS):
#   */5 * * * *  cd /var/www/setareganplus && npm run crm:automation-worker-once
#   */10 * * * * cd /var/www/setareganplus && npm run crm:scheduled-worker-once
#   */2 * * * *  cd /var/www/setareganplus && npm run communication:worker-once
