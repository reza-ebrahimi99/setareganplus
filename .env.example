# PostgreSQL connection
DATABASE_URL="postgresql://setaregan:CHANGE_ME@127.0.0.1:5432/setareganplus?schema=public"

# Single admin login (/admin). Generate the hash with: npm run admin:hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Where uploads live (public images + private form files). Keep OUTSIDE the release dir in production.
UPLOAD_DIR=./storage/uploads

# Optional: build into a different folder (zero-downtime / low-memory builds)
# NEXT_BUILD_DIST_DIR=.next-build

# Optional
# SITE_URL=https://setareganplus.ir
# INSECURE_COOKIES=1   # only if the admin is served over plain http (not recommended)

# ---- Booklet shop (فروشگاه جزوه) ----
# Zibal payment gateway. "zibal" = sandbox merchant for local testing.
ZIBAL_MERCHANT_ID=
# ZIBAL_TIMEOUT_MS=15000
# SMS.ir (verify/template API). Leave disabled to run the shop without SMS (orders still work).
STAROS_SMS_ENABLED=false
SMSIR_API_KEY=
SMSIR_PURCHASE_TEMPLATE_ID=
SMSIR_READY_TEMPLATE_ID=
SMSIR_ADMIN_TEMPLATE_ID=
# Payment callbacks + SMS links are built from SITE_URL, so set it in production:
# SITE_URL=https://setareganplus.ir
# Only for the migration script (deploy/lean/update.sh fills these automatically):
# OLD_DATABASE_URL=postgresql://…   OLD_MEDIA_ROOT=/var/www/staros-media
