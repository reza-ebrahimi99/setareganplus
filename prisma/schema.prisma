// Setaregan Plus (lean) — public site + small admin.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value site settings (contact, hours, social, stats, home copy, about copy).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// The two centers: آموزشگاه تقویتی و کنکور ستارگان / نمایندگی قلم‌چی نسیم‌شهر
model Center {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  shortName  String
  tagline    String?
  intro      String?  @db.Text
  /// Free text; blank line = new paragraph
  body       String?  @db.Text
  /// [{title, text}]
  highlights Json     @default("[]")
  /// [{name, address, mapUrl}]
  branches   Json     @default("[]")
  heroImage  String?
  /// Slug of a builder form embedded on the center page
  formSlug   String?
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  /// e.g. "مدیر ارشد علمی · مدرس شیمی"
  role       String
  education  String?
  department String?
  /// One item per line
  bio        String?  @db.Text
  photo      String?
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

enum AchievementCategory {
  KONKUR
  GIFTED
  OTHER
}

model Achievement {
  id        String              @id @default(cuid())
  name      String
  category  AchievementCategory @default(GIFTED)
  grade     String?
  /// School / major / university
  detail    String?
  /// e.g. ۱۴۰۴-۱۴۰۵
  year      String?
  photo     String?
  featured  Boolean             @default(false)
  published Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?        @db.Text
  center      String?
  cover       String?
  published   Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  path      String
  caption   String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([albumId, sortOrder])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Form builder. `fields` is an ordered JSON array of FieldDef (see lib/forms/types.ts).
model Form {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  description     String?        @db.Text
  fields          Json           @default("[]")
  status          FormStatus     @default(DRAFT)
  submitLabel     String         @default("ثبت درخواست")
  successMessage  String         @default("درخواست شما ثبت شد. همکاران ما به‌زودی با شما تماس می‌گیرند.")
  /// Built-in forms (e.g. pre-registration) cannot be deleted
  isSystem        Boolean        @default(false)
  // ---- v2 (phase 6): look, schedule, capacity, payment ----
  coverImage      String?
  logo            String?
  /// colour preset key (lib/forms/themes.ts)
  theme           String         @default("navy")
  /// shown on /forms and on the home page when published
  listed          Boolean        @default(true)
  opensAt         DateTime?
  closesAt        DateTime?
  /// max accepted registrations (free + paid + pending holds); null = unlimited
  capacity        Int?
  /// NONE | MOBILE | NATIONAL_CODE: one registration per value
  uniqueBy        String         @default("NONE")
  successTitle    String?
  /// optional internal path or https URL to send the registrant to after success
  successRedirect String?
  /// SMS confirmation to the registrant / notification to the admins
  smsConfirm      Boolean        @default(false)
  adminNotify     Boolean        @default(false)
  /// FREE | FIXED | OPTIONS (base price + option prices stored on the fields)
  payMode         String         @default("FREE")
  basePriceRials  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  submissions     Submission[]
  discounts       FormDiscount[]
}

enum FormPayState {
  NONE
  PENDING
  PAID
  FAILED
}

/// Discount codes for paid forms
model FormDiscount {
  id          String    @id @default(cuid())
  formId      String
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  /// upper-case latin/digits
  code        String
  percent     Int?
  amountRials Int?
  maxUses     Int?
  used        Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([formId, code])
}

/// Zibal payment attempts for form registrations (same flow as the shop's Payment)
model FormPayment {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  provider     String     @default("zibal")
  amountRials  Int
  status       PayStatus  @default(PENDING)
  /// secret token in our callback URL
  token        String     @unique
  trackId      String?    @unique
  refNumber    String?
  cardNumber   String?
  result       Int?
  message      String?
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([submissionId])
  @@index([status, createdAt])
}

enum SubmissionStatus {
  NEW
  CONTACTED
  ENROLLED
  ARCHIVED
}

model Submission {
  id            String           @id @default(cuid())
  formId        String
  form          Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  /// { [fieldId]: value }
  data          Json
  /// Snapshot of field labels at submit time { [fieldId]: label }
  labels        Json             @default("{}")
  status        SubmissionStatus @default(NEW)
  note          String?          @db.Text
  // ---- v2 (phase 6) ----
  /// secret token of the public receipt page /f/r/<token>
  token         String?          @unique
  /// normalized copies for uniqueness checks and SMS
  mobile        String?
  nationalCode  String?
  payState      FormPayState     @default(NONE)
  /// final amount to pay (after discount), rials
  amountRials   Int              @default(0)
  /// price lines at submit time [{label, rials}]
  priceLines    Json             @default("[]")
  discountCode  String?
  discountRials Int              @default(0)
  paidAt        DateTime?
  payments      FormPayment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([formId, createdAt])
  @@index([status])
  @@index([formId, payState])
  @@index([formId, mobile])
  @@index([formId, nationalCode])
}

// ───────────────────────── Booklet shop (فروشگاه جزوه) ─────────────────────────

/// A printed booklet. Prices are stored in Rials (Zibal works in Rials); the site shows Toman.
model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  /// Teacher / author, e.g. «مهندس رضا ابراهیمی»
  author         String?
  summary        String?
  description    String?     @db.Text
  cover          String?
  priceRials     Int
  /// Optional "was" price (crossed out)
  compareAtRials Int?
  subject        String?
  /// One of GRADES (lib/shop/config.ts), e.g. «دوازدهم»
  grade          String?
  /// Any of MAJORS; empty = all majors
  majors         String[]    @default([])
  /// "ghalamchi" | "education" | null (both)
  center         String?
  pageCount      Int?
  /// Free "key: value" lines (print, binding, size, …)
  specs          String?     @db.Text
  /// null = unlimited
  stock          Int?
  active         Boolean     @default(true)
  featured       Boolean     @default(false)
  sortOrder      Int         @default(0)
  legacyId       String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([active, sortOrder])
}

enum OrderStage {
  REGISTERED
  PAID
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum PayStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id             String       @id @default(cuid())
  /// ORD-YYYYMMDD-NNNNN (same format as the old shop)
  number         String       @unique
  /// 6-char code used in SMS links: /o/{shortCode}
  shortCode      String       @unique
  /// Secret token of the pickup ticket: /booklet/{qrToken}
  qrToken        String       @unique
  stage          OrderStage   @default(REGISTERED)
  payStatus      PayStatus    @default(UNPAID)
  /// ONLINE | CASH | CARD | TRANSFER | OTHER
  payMethod      String       @default("ONLINE")
  buyerName      String
  mobile         String
  nationalCode   String?
  parentName     String?
  grade          String?
  major          String?
  /// BOYS | GIRLS (| ELEMENTARY for legacy orders)
  branch         String
  /// Buyer's note at checkout
  customerNote   String?      @db.Text
  /// Staff-only note
  adminNote      String?      @db.Text
  subtotalRials  Int
  totalRials     Int
  paidAt         DateTime?
  inProductionAt DateTime?
  readyAt        DateTime?
  deliveredAt    DateTime?
  /// Who picked it up (name), set at the pickup desk
  deliveredTo    String?
  /// web | admin | legacy
  source         String       @default("web")
  legacyId       String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]

  @@index([stage, createdAt])
  @@index([payStatus, paidAt])
  @@index([mobile])
  @@index([branch])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title      String
  unitRials  Int
  qty        Int      @default(1)
  totalRials Int
  legacyId   String?  @unique

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// STAGE | NOTE | PAYMENT | SMS | SYSTEM
  type      String
  stage     OrderStage?
  text      String
  /// Who did it (staff display name), null = system / buyer
  actor     String?
  legacyId  String?     @unique
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

/// One online payment attempt (Zibal). Verification is idempotent: only one PENDING→PAID transition per row.
model Payment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String    @default("zibal")
  amountRials Int
  status      PayStatus @default(PENDING)
  /// Secret token in our callback URL
  token       String    @unique
  trackId     String?   @unique
  refNumber   String?
  cardNumber  String?
  /// Last Zibal result code
  result      Int?
  message     String?
  paidAt      DateTime?
  legacyId    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model SmsLog {
  id           String   @id @default(cuid())
  orderId      String?
  /// form registrations (phase 6)
  submissionId String?
  /// purchase | ready | admin
  kind         String
  mobile       String
  /// SENT | FAILED | SKIPPED
  status       String
  detail       String?
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// Admin-panel staff accounts (the owner stays in .env: ADMIN_USERNAME / ADMIN_PASSWORD_HASH).
model StaffUser {
  id             String    @id @default(cuid())
  /// lowercase, [a-z0-9._-]
  username       String    @unique
  fullName       String
  mobile         String?
  /// scrypt:<saltHex>:<hashHex> (same format as ADMIN_PASSWORD_HASH)
  passwordHash   String
  /// permission keys, see lib/perms.ts
  permissions    String[]  @default([])
  active         Boolean   @default(true)
  /// bumped on password reset / deactivation -> old sessions die
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Simple activity log of key admin actions.
model AdminLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  text      String
  target    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// اخبار و اطلاعیه‌ها
model News {
  id          String    @id @default(cuid())
  /// latin/persian slug used in /news/<slug>
  slug        String    @unique
  title       String
  summary     String?
  /// safe markdown subset (see lib/markdown.ts)
  body        String    @default("") @db.Text
  cover       String?
  /// ANNOUNCE | EXAM | CLASSES | RESULTS | GENERAL
  category    String    @default("ANNOUNCE")
  pinned      Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  /// optional call-to-action: builder form slug or product slug
  formSlug    String?
  productSlug String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ───────────────────────── Study-style quiz campaign (کمپین تست مطالعه) ─────────────────────────

/// Pending OTP for the public study quiz. Cleared after verify or expiry.
model StudyQuizOtp {
  id         String    @id @default(cuid())
  mobile     String
  /// sha256 of the OTP (never store the raw code)
  codeHash   String
  firstName  String
  lastName   String
  grade      String
  field      String?
  referral   String?
  ip         String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@index([expiresAt])
}

/// One completed (or resumed) lead from the study quiz. Mobile is unique: one quiz per phone.
model StudyQuizLead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  grade       String
  /// رشته (optional for grades below دهم)
  field       String?
  mobile      String   @unique
  /// archetype key, e.g. planner / wave / crammer / perfectionist / scatter
  archetype   String
  /// { [questionId]: optionIndex }
  answers     Json     @default("{}")
  /// unique public reward / discount code shown on the result screen
  rewardCode  String   @unique
  /// ?ref= value that brought this student (usually another lead's rewardCode)
  referral    String?
  contacted   Boolean  @default(false)
  note        String?  @db.Text
  ip          String?
  userAgent   String?
  verifiedAt  DateTime
  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([archetype])
  @@index([grade])
  @@index([createdAt])
  @@index([contacted])
  @@index([referral])
}

// ───────────────────────── First-party traffic analytics ─────────────────────────
// Raw rows keep no IP, name, phone, or cookie. `visitor` is an HMAC that rotates
// every Tehran midnight, so people are not stitched across days. After
// RAW_RETENTION_DAYS the rows are folded into AnalyticsDaily and deleted.

/// One public page view or quiz signal.
model AnalyticsHit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Asia/Tehran calendar day, YYYY-MM-DD
  day       String
  /// pageview | quiz_start | quiz_complete
  kind      String
  /// Public path only; query string is never stored
  path      String
  source    String
  medium    String   @default("")
  campaign  String   @default("")
  /// Daily HMAC of the visitor cookie. Not reversible and not stable across days.
  visitor   String

  @@index([day])
  @@index([day, kind])
  @@index([createdAt])
}

/// Compact totals after raw hits age out. No visitor identifiers.
/// level is site, source, campaign, or path.
model AnalyticsDaily {
  id       String @id @default(cuid())
  day      String
  level    String
  kind     String
  path     String @default("")
  source   String @default("")
  medium   String @default("")
  campaign String @default("")
  hits     Int
  uniques  Int

  @@unique([day, level, kind, path, source, medium, campaign], map: "AnalyticsDaily_bucket_key")
  @@index([day, kind, level])
}

// ───────────────────────── Free consultation booking ─────────────────────────
// Schedules start empty. Nothing here is seeded: a consultant has no bookable
// time until staff save a weekly window or an extra day.

model Consultant {
  id             String   @id @default(cuid())
  name           String
  specialty      String   @default("")
  bio            String?  @db.Text
  photo          String?
  offersPublic   Boolean  @default(false)
  offersSpecial  Boolean  @default(false)
  offersOnline   Boolean  @default(false)
  offersInPerson Boolean  @default(false)
  /// Hidden until staff turn this on AND add a real window
  active         Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  windows       ConsultantWindow[]
  exceptions    ConsultantException[]
  consultations Consultation[]
  seats         ConsultationSeat[]
}

/// Weekly hours in Asia/Tehran. weekday: 0 = Saturday … 6 = Friday.
model ConsultantWindow {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  weekday      Int
  /// "HH:MM"
  startTime    String
  endTime      String
  /// null = site default (settings, normally 30)
  slotMinutes  Int?
  /// null = 1
  capacity     Int?
  online       Boolean    @default(false)
  inPerson     Boolean    @default(false)
  /// PUBLIC | SPECIAL | BOTH
  audience     String     @default("BOTH")

  @@index([consultantId])
}

/// A day off or an extra working day. `date` is the Tehran civil date, YYYY-MM-DD.
model ConsultantException {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  date         String
  /// OFF | EXTRA
  kind         String
  startTime    String?
  endTime      String?
  slotMinutes  Int?
  capacity     Int?
  online       Boolean    @default(false)
  inPerson     Boolean    @default(false)
  /// PUBLIC | SPECIAL | BOTH
  audience     String     @default("BOTH")
  note         String?

  @@index([consultantId, date])
}

/// One reserved conversation. The seat row is what makes double-booking impossible.
model Consultation {
  id              String     @id @default(cuid())
  /// Public reference shown to the family. Not a login secret.
  code            String     @unique
  /// PUBLIC | SPECIAL
  audience        String
  /// ONLINE | IN_PERSON
  mode            String
  /// PENDING | CONFIRMED | CANCELLED
  status          String     @default("PENDING")
  consultantId    String
  consultant      Consultant @relation(fields: [consultantId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  bookerName      String
  /// PARENT | STUDENT
  bookerRole      String
  studentName     String
  grade           String
  mobile          String
  /// SMS | ACCESS_CODE
  phoneProof      String
  note            String?    @db.Text
  studentId       String?
  student         EnrolledStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  source          String     @default("")
  medium          String     @default("")
  campaign        String     @default("")
  cancelReason    String?
  cancelledAt     DateTime?
  rescheduledFrom DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  seat            ConsultationSeat?
  notices         ConsultNotice[]

  @@index([status, startsAt])
  @@index([mobile])
  @@index([consultantId, startsAt])
  @@index([audience, createdAt])
  @@index([studentId])
}

/// Holds one place in a slot. Deleted when the booking is cancelled or moved.
model ConsultationSeat {
  id             String       @id @default(cuid())
  consultantId   String
  consultant     Consultant   @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  seat           Int
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultantId, startsAt, seat])
}

/// Enrolled student. The access code is stored only as an HMAC; staff see it once.
model EnrolledStudent {
  id          String         @id @default(cuid())
  fullName    String
  /// Trusted school phone. When set, the special session does not ask for another SMS.
  mobile      String?
  grade       String?
  note        String?        @db.Text
  active      Boolean        @default(true)
  codeHash    String         @unique
  /// Last 4 characters, so staff can recognise a slip. Not enough to sign in.
  codeSuffix  String
  /// Bumped when the code is replaced; old cookies stop working.
  codeVersion Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  consultations Consultation[]

  @@index([active])
  @@index([mobile])
}

model ConsultOtp {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  ipHash     String?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@index([expiresAt])
}

/// Failed and successful code attempts. Stores a hash of the IP, never the code.
model ConsultCodeAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model ConsultNotice {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  /// CREATED | CANCELLED | MOVED | REMINDER
  kind           String
  mobile         String
  body           String       @db.Text
  /// QUEUED | SENDING | SENT | FAILED | SKIPPED
  status         String
  detail         String?
  /// Reminder idempotency: one reminder per booked instant.
  slotStartsAt   DateTime?
  createdAt      DateTime     @default(now())
  sentAt         DateTime?

  @@index([consultationId, kind])
  @@index([status, createdAt])
}

// ───────────────────────── Video courses (کلاس‌های ویدیویی) ─────────────────────────
// Additive. Booklet orders, the study quiz, consultation and news are untouched.

/// A course. Topic playlists are TOPIC; leftover grade playlists are GRADE.
model ClassCourse {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String?  @db.Text
  intro          String?  @db.Text
  /// Uploaded cover under /media. Empty = generated art.
  cover          String?
  teacher        String   @default("مهندس رضا ابراهیمی")
  /// Grade ids: g2…g12, konkur
  grades         String[] @default([])
  /// riazi | tajrobi | ensani
  fields         String[] @default([])
  /// TOPIC | GRADE
  kind           String   @default("TOPIC")
  /// List price in rials. Struck through when the course is free or discounted.
  priceRials     Int      @default(0)
  /// Discounted price in rials. Null = no discount. Ignored when isFree.
  salePriceRials Int?
  isFree         Boolean  @default(false)
  /// Shop product slug for the lesson upsell. Empty = no booklet card.
  bookletSlug    String   @default("")
  suggestConsult Boolean  @default(true)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lessons      ClassLesson[]
  files        ClassFile[]
  enrollments  ClassEnrollment[]
  payments     ClassPayment[]
  steps        ClassPathStep[]
  certificates ClassCertificate[]
  chapters     ClassChapter[]
  practice     QuizAttempt[]

  @@index([published, kind, sortOrder])
}

model ClassLesson {
  id          String      @id @default(cuid())
  courseId    String
  course      ClassCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Host video id. Never shown as a link on the student site.
  aparatHash  String      @unique
  title       String
  description String?     @db.Text
  durationSec Int?
  /// Cached poster under /media. Students never see an upstream image URL.
  poster      String?
  /// Watchable after login without buying the course.
  freePreview Boolean     @default(false)
  grades      String[]    @default([])
  fields      String[]    @default([])
  sortOrder   Int         @default(0)
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  files     ClassFile[]
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  progress  ClassProgress[]
  threads   ClassThread[]

  @@index([courseId, sortOrder])
}

model ClassFile {
  id         String       @id @default(cuid())
  title      String
  fileName   String
  /// Relative key under private uploads.
  storageKey String
  bytes      Int          @default(0)
  mime       String       @default("application/pdf")
  courseId   String?
  course     ClassCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     ClassLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  published  Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([courseId])
  @@index([lessonId])
}

/// Student of the video courses. Not an EnrolledStudent (that model is the consultation access code).
model ClassStudent {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  mobile       String    @unique
  /// Grade id from the consultation list (پایه دوم … کنکور).
  grade        String
  /// riazi | tajrobi | ensani | null
  field        String?
  points       Int       @default(0)
  streak       Int       @default(0)
  /// Tehran civil date YYYY-MM-DD of the last learning day.
  lastActiveOn String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  enrollments  ClassEnrollment[]
  payments     ClassPayment[]
  progress     ClassProgress[]
  attempts     QuizAttempt[]
  threads      ClassThread[]
  pointRows    ClassPoint[]
  pointLogs    ClassPointLog[]
  badges       ClassBadge[]
  certificates ClassCertificate[]

  @@index([grade])
}

model ClassOtp {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String
  firstName  String
  lastName   String
  grade      String
  field      String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@index([expiresAt])
}

model ClassEnrollment {
  id        String       @id @default(cuid())
  studentId String
  courseId  String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    ClassCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// FREE | PAID | ADMIN
  source    String
  createdAt DateTime     @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

/// Online payment for a course. Separate from booklet Payment rows.
model ClassPayment {
  id          String       @id @default(cuid())
  courseId    String
  course      ClassCourse  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  studentId   String
  student     ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountRials Int
  status      PayStatus    @default(PENDING)
  token       String       @unique
  trackId     String?      @unique
  refNumber   String?
  cardNumber  String?
  result      Int?
  message     String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([studentId, courseId])
  @@index([status, createdAt])
}

model ClassProgress {
  id             String       @id @default(cuid())
  studentId      String
  student        ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         ClassLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  secondsWatched Int          @default(0)
  completed      Boolean      @default(false)
  opens          Int          @default(0)
  lastBeatAt     DateTime?
  lastOpenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId, updatedAt])
}

/// One multiple-choice question attached to a lesson. Synced from qbank by externalId.
model QuizQuestion {
  id          String      @id @default(cuid())
  lessonId    String
  lesson      ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt      String      @db.Text
  explanation String?     @db.Text
  sortOrder   Int         @default(0)
  /// Stable id from qbank.setareganplus.ir. Null for questions typed in the panel.
  externalId  String?     @unique
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  choices     QuizChoice[]

  @@index([lessonId, sortOrder])
}

model QuizChoice {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String       @db.Text
  correct    Boolean      @default(false)
  sortOrder  Int          @default(0)

  @@index([questionId, sortOrder])
}

model QuizAttempt {
  id        String       @id @default(cuid())
  studentId String
  lessonId  String?
  courseId  String?
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    ClassLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    ClassCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  /// { [questionId]: choiceId }
  answers   Json
  createdAt DateTime     @default(now())

  @@index([studentId, lessonId])
  @@index([studentId, courseId])
}

/// Idempotent point grant. `key` is watch:lesson, quiz:lesson or course:course.
model ClassPoint {
  id        String       @id @default(cuid())
  studentId String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  key       String
  points    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([studentId, key])
  @@index([studentId])
}

/// One delta, so the weekly board can sum points earned this week.
model ClassPointLog {
  id        String       @id @default(cuid())
  studentId String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([studentId, createdAt])
}

model ClassBadge {
  id        String       @id @default(cuid())
  studentId String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// streak_7 | course_complete
  kind      String
  /// Empty string for badges that are not about one course.
  courseId  String       @default("")
  earnedAt  DateTime     @default(now())

  @@unique([studentId, kind, courseId])
  @@index([studentId])
}

model ClassCertificate {
  id        String       @id @default(cuid())
  studentId String
  courseId  String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    ClassCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code      String       @unique
  issuedAt  DateTime     @default(now())

  @@unique([studentId, courseId])
}

/// Suggested order of courses for one grade and field.
model ClassPath {
  id        String          @id @default(cuid())
  grade     String
  /// riazi | tajrobi | ensani | "" = any field
  field     String          @default("")
  title     String
  published Boolean         @default(true)
  steps     ClassPathStep[]

  @@unique([grade, field])
}

model ClassPathStep {
  id        String      @id @default(cuid())
  pathId    String
  path      ClassPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId  String
  course    ClassCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)
  note      String?

  @@unique([pathId, courseId])
  @@index([pathId, sortOrder])
}

/// A student question under a lesson. Hidden until staff publish it.
model ClassThread {
  id        String       @id @default(cuid())
  lessonId  String
  lesson    ClassLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   ClassStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String       @db.Text
  /// PENDING | PUBLISHED | HIDDEN
  status    String       @default("PENDING")
  createdAt DateTime     @default(now())
  replies   ClassReply[]

  @@index([lessonId, status])
  @@index([status, createdAt])
}

model ClassReply {
  id        String      @id @default(cuid())
  threadId  String
  thread    ClassThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body      String      @db.Text
  author    String
  createdAt DateTime    @default(now())

  @@index([threadId])
}

/// A question mirrored from the institute bank. Students only see our cached image paths.
model BankQuestion {
  externalId    String       @id
  grade         Int
  /// riazi | tajrobi | ensani
  field         String
  difficulty    Int          @default(2)
  chapters      String[]     @default([])
  prompt        String       @db.Text
  solution      String?      @db.Text
  /// Persian label such as آزمون قلم‌چی ۱۴۰۳. Empty when there is nothing polite to show.
  sourceLabel   String       @default("")
  /// /media/qbank/... never a remote URL
  imagePath     String?
  solutionPaths String[]     @default([])
  active        Boolean      @default(true)
  updatedAt     DateTime     @updatedAt
  options       BankOption[]

  @@index([field, difficulty])
  @@index([active])
}

model BankOption {
  id         String       @id @default(cuid())
  questionId String
  question   BankQuestion @relation(fields: [questionId], references: [externalId], onDelete: Cascade)
  text       String       @db.Text
  correct    Boolean      @default(false)
  sortOrder  Int          @default(0)

  @@index([questionId, sortOrder])
}

/// Chapter code attached to a whole course (lessonId "") or one lesson.
/// Chapter code on a course. lessonId "" means every lesson in the course.
model ClassChapter {
  id       String      @id @default(cuid())
  courseId String
  course   ClassCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId String      @default("")
  code     String

  @@unique([courseId, lessonId, code])
  @@index([courseId, lessonId])
}

model BankSync {
  id       String   @id @default("main")
  sinceId  Int      @default(0)
  imported Int      @default(0)
  skipped  Int      @default(0)
  note     String   @default("")
  ranAt    DateTime @default(now())
}
